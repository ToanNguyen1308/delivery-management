<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="007-1-create-table-notifications" author="delivery">
        <createTable tableName="notifications">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="VARCHAR(1000)"/>
            <column name="reference_type" type="VARCHAR(50)"/>
            <column name="reference_id" type="BIGINT"/>
            <column name="reference_code" type="VARCHAR(50)"/>
            <column name="is_read" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="read_at" type="TIMESTAMP"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="notifications" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_notifications_user"/>
        <createIndex tableName="notifications" indexName="idx_notifications_user_read">
            <column name="user_id"/>
            <column name="is_read"/>
        </createIndex>
    </changeSet>

    <changeSet id="007-2-create-table-stored-files" author="delivery">
        <createTable tableName="stored_files">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="object_key" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="bucket" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="original_name" type="VARCHAR(255)"/>
            <column name="content_type" type="VARCHAR(100)"/>
            <column name="size_bytes" type="BIGINT"/>
            <column name="url" type="VARCHAR(1000)"/>
            <column name="feature" type="VARCHAR(50)"/>
            <column name="reference_id" type="BIGINT"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="stored_files" indexName="idx_stored_files_feature_ref">
            <column name="feature"/>
            <column name="reference_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

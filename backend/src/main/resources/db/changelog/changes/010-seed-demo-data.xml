    <changeSet id="010-2-map-demo-users-role-groups" author="delivery">
        <sql>
            INSERT INTO user_role_group (user_id, role_group_id)
            SELECT u.id, rg.id FROM users u, role_groups rg
            WHERE u.username = 'admin' AND rg.role_group_code = 'ADMIN'
        </sql>
        <sql>
            INSERT INTO user_role_group (user_id, role_group_id)
            SELECT u.id, rg.id FROM users u, role_groups rg
            WHERE u.username = 'dispatcher' AND rg.role_group_code = 'DISPATCHER'
        </sql>
        <sql>
            INSERT INTO user_role_group (user_id, role_group_id)
            SELECT u.id, rg.id FROM users u, role_groups rg
            WHERE u.username IN ('shipper01', 'shipper02', 'shipper03') AND rg.role_group_code = 'SHIPPER'
        </sql>
        <sql>
            INSERT INTO user_role_group (user_id, role_group_id)
            SELECT u.id, rg.id FROM users u, role_groups rg
            WHERE u.username IN ('customer01', 'customer02') AND rg.role_group_code = 'CUSTOMER'
        </sql>
    </changeSet>


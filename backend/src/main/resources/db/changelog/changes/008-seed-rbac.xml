    <changeSet id="008-3-map-admin-functions" author="delivery">
        <sql>
            INSERT INTO role_group_function (role_group_id, function_id)
            SELECT rg.id, f.id
            FROM role_groups rg CROSS JOIN functions f
            WHERE rg.role_group_code = 'ADMIN'
        </sql>
    </changeSet>

    <changeSet id="008-4-map-dispatcher-functions" author="delivery">
        <sql>
            INSERT INTO role_group_function (role_group_id, function_id)
            SELECT rg.id, f.id
            FROM role_groups rg CROSS JOIN functions f
            WHERE rg.role_group_code = 'DISPATCHER'
              AND f.function_code IN ('ROLE_USER_VIEW', 'ROLE_SHIPPER_VIEW', 'ROLE_SHIPPER_UPDATE',
                                      'ROLE_ORDER_VIEW', 'ROLE_ORDER_CREATE', 'ROLE_ORDER_UPDATE',
                                      'ROLE_ORDER_CANCEL', 'ROLE_ORDER_CONFIRM', 'ROLE_ORDER_IMPORT',
                                      'ROLE_ORDER_EXPORT', 'ROLE_DISPATCH_VIEW', 'ROLE_DISPATCH_ASSIGN',
                                      'ROLE_TRACKING_VIEW', 'ROLE_PRICING_VIEW', 'ROLE_VOUCHER_VIEW',
                                      'ROLE_PAYMENT_VIEW', 'ROLE_COD_VIEW', 'ROLE_COD_CONFIRM',
                                      'ROLE_DASHBOARD_VIEW')
        </sql>
    </changeSet>

    <changeSet id="008-5-map-shipper-functions" author="delivery">

# ==========================================================
# Cau hinh he thong quan ly giao hang
# Copy file nay thanh .env truoc khi chay: cp .env.example .env
# KHONG commit file .env len Git
# ==========================================================

# ---------- Database (PostgreSQL) ----------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=delivery_db
DB_USERNAME=delivery_user
DB_PASSWORD=delivery_pass_2026
DB_URL=jdbc:postgresql://postgres:5432/delivery_db
DB_DRIVER=org.postgresql.Driver

# Hibernate tu nhan dien dialect tu ket noi JDBC nen khong can khai bao.
# Neu can doi sang MariaDB, chi thay 2 bien tren bang:
# DB_URL=jdbc:mariadb://mariadb:3306/delivery_db
# DB_DRIVER=org.mariadb.jdbc.Driver

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- MinIO (Object Storage) ----------
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=delivery-files

# ---------- JWT ----------
# Secret phai du 32 ky tu cho thuat toan HS256
JWT_SECRET=viettel-delivery-super-secret-key-change-me-in-production-2026
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---------- Ung dung ----------
APP_PORT=8080
APP_CONTEXT_PATH=/api/v1
SPRING_PROFILES_ACTIVE=docker
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Cong mo ra may that (chi anh huong Docker) ----------
# Cac container van goi nhau qua ten service nen doi may bien nay khong lam hong gi.
# Chi doi khi may ban da co san PostgreSQL / Redis / MinIO chiem cong do,
# luc up se bao "ports are not available: address already in use".
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------- VNPay Sandbox ----------
# Dang ky tai https://sandbox.vnpayment.vn/devreg/ de lay TmnCode va HashSecret
VNPAY_ENABLED=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:3000/payment/result
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn

# ---------- Dieu phoi ----------
# Chien luoc gan don tu dong: NEAREST | LEAST_LOAD | ROUND_ROBIN
DISPATCH_STRATEGY=NEAREST
DISPATCH_MAX_RADIUS_KM=15
